PORT=5000
# Leave MONGODB_URI empty to serve the bank straight from src/data/challenges.json (no database needed).
# Set it to your MongoDB Atlas string to store challenges in MongoDB; they are seeded/updated automatically on every start.
MONGODB_URI=
# Comma-separated list of allowed frontend origins (Vercel URL, localhost). Use * to allow all (dev only).
CORS_ORIGIN=http://localhost:5173
